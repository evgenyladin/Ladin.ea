@{
    ViewData["Title"] = "Главная";
}

<div class="text-center mt-5">
    <h1 class="display-4">Добро пожаловать в ECommerce Csv Import</h1>
    <p class="lead mt-3">Этот модуль позволяет импортировать товары из CSV файлов в память приложения.</p>
    <div class="mt-4">
        <a asp-controller="Products" asp-action="Import" class="btn btn-primary btn-lg">Перейти к импорту</a>
        <a asp-controller="Products" asp-action="Index" class="btn btn-success btn-lg">Список товаров</a>
    </div>
</div>